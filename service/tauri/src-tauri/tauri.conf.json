{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix",
  "version": "0.4.0",
  "identifier": "ai.phoenix.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phoenix",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "backgroundColor": "#0A0A0F",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; img-src 'self' data: http://127.0.0.1:* https:; media-src 'self' data: blob: http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
